{
  "name": "opencode-skill-evolution",
  "version": "1.0.0",
  "description": "OpenCode plugin that learns from skill usage and suggests relevant skills automatically",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": {
    "name": "bigknoxy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigknoxy/opencode-skill-evolution.git"
  },
  "bugs": {
    "url": "https://github.com/bigknoxy/opencode-skill-evolution/issues"
  },
  "homepage": "https://github.com/bigknoxy/opencode-skill-evolution#readme",
  "keywords": [
    "opencode",
    "plugin",
    "skill",
    "learning",
    "recommendations",
    "ai",
    "telemetry"
  ],
  "opencode": {
    "type": "plugin",
    "hooks": [
      "session.start",
      "tool.execute.after",
      "session.compacted"
    ]
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "dev": "bun build ./src/index.ts --outdir ./dist --target node --watch",
    "clean": "rm -rf dist",
    "rebuild": "bun run clean && bun run build",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.0",
    "@xenova/transformers": "^2.17.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/npm": "^12.0.0",
    "@types/bun": "latest",
    "semantic-release": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "release": {
    "branches": ["main"],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git"
    ]
  }
}